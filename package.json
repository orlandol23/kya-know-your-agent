{
  "name": "kya",
  "version": "0.1.0",
  "private": true,
  "description": "Know Your Agent: on-chain reputation for AI agents that pay through x402",
  "license": "MIT",
  "author": "Orlando Fernandes",
  "repository": {
    "type": "git",
    "url": "https://github.com/orlandol23/kya-know-your-agent.git"
  },
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "start:offline": "tsx src/server.ts --offline",
    "demo:endpoint": "tsx demo/paid-endpoint.ts",
    "demo:endpoint:offline": "tsx demo/paid-endpoint.ts --offline",
    "demo:agents": "tsx demo/agents.ts",
    "demo:agents:offline": "tsx demo/agents.ts --offline",
    "collect": "tsx scripts/collect.ts",
    "capture": "tsx scripts/capture.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "viem": "^2.21.55",
    "x402-express": "^1.2.0",
    "x402-fetch": "^1.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
