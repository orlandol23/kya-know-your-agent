# Blockscout Pro API key. REQUIRED: every signal call is key-gated and answers
# 402 without it. https://blockscout.com -> API keys.
BLOCKSCOUT_API_KEY=

# Blockscout Pro API. Where the signals are read from.
#   v2                   {BLOCKSCOUT_API_URL}/{CHAIN_ID}/api/v2/...
#   Etherscan-compatible {BLOCKSCOUT_API_URL}/v2/api?chain_id={CHAIN_ID}&...
BLOCKSCOUT_API_URL=https://api.blockscout.com
BLOCKSCOUT_CHAIN_ID=8453

# Public explorer. Used ONLY to build the human-clickable evidence link that
# ships with the attestation. Never called by the code.
BLOCKSCOUT_EXPLORER_URL=https://base.blockscout.com

# Throwaway key that signs attestations. It never holds funds. Generate one:
#   node -e "import('viem/accounts').then(a => console.log(a.generatePrivateKey()))"
# The matching address is printed when the server starts: that is the address
# consumers pin to verify signatures.
ATTESTER_PRIVATE_KEY=

PORT=3000

# ── demo/ (D5) ───────────────────────────────────────────────────────────────
# Paid endpoint port. Reputation is read from Base MAINNET above; the payment
# runs on Base SEPOLIA with the same address.
DEMO_PORT=4021

# Where the endpoint receives USDC. Defaults to the attester address, which is
# fine for the default SIMULATED settlement and wrong for --real: set your own.
DEMO_PAY_TO=

# --real only. A wallet with Base mainnet history (KYA score above 84) that
# holds USDC on Base Sepolia (Circle faucet). Without it, agents.ts --real runs
# the fresh agent only, and the default mode sends a synthetic header for the
# established address instead.
DEMO_ESTABLISHED_PRIVATE_KEY=

# Optional. Generated on every run when absent, which is what "fresh" means.
DEMO_FRESH_PRIVATE_KEY=

# Optional. Where agents.ts sends the request. Default http://localhost:$DEMO_PORT/chem
DEMO_URL=
