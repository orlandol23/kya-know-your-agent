# Blockscout Pro API key. REQUIRED: every signal call is key-gated and answers
# 402 without it. https://blockscout.com -> API keys.
BLOCKSCOUT_API_KEY=

# Blockscout Pro API. Where the signals are read from.
#   v2                   {BLOCKSCOUT_API_URL}/{CHAIN_ID}/api/v2/...
#   Etherscan-compatible {BLOCKSCOUT_API_URL}/v2/api?chain_id={CHAIN_ID}&...
BLOCKSCOUT_API_URL=https://api.blockscout.com
BLOCKSCOUT_CHAIN_ID=8453

# Public explorer. Used ONLY to build the human-clickable evidence link that
# ships with the attestation. Never called by the code.
BLOCKSCOUT_EXPLORER_URL=https://base.blockscout.com

# Throwaway key used to sign attestations. Not needed before D4.
ATTESTER_PRIVATE_KEY=

PORT=3000
